#!/usr/bin/env bash
# Banc officiel Go vs ghmcp : sans réseau, jeton factice. Usage : GO_SRC=<clone github-mcp-server> bash bench/run
# Variables : GO_SRC (obligatoire, ou 1er argument), TRIALS (défaut 15), OUT (défaut bench/.out, ignoré par git), GO_COMMIT/RS_COMMIT (sinon lus par git), CPUS (note de plateforme).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
GO_SRC="${GO_SRC:-${1:-}}"
[ -n "$GO_SRC" ] && [ -d "$GO_SRC/cmd/github-mcp-server" ] || { echo "GO_SRC doit pointer vers le clone de github-mcp-server" >&2; exit 2; }
OUT="${OUT:-$ROOT/bench/.out}"; mkdir -p "$OUT"
EXE=""; case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) EXE=".exe";; esac
GO_BIN="$OUT/github-mcp-server$EXE"
(cd "$GO_SRC" && go build -o "$GO_BIN" ./cmd/github-mcp-server)
(cd "$ROOT" && cargo build --release -p ghmcp)
TARGET="$(cd "$ROOT" && cargo metadata --format-version 1 --no-deps | node -e 'process.stdout.write(JSON.parse(require("fs").readFileSync(0,"utf8")).target_directory)')"
RS_BIN="$TARGET/release/ghmcp$EXE"
# Config factice : le jeton n'est lu qu'à un vrai appel GitHub, jamais ici.
cat > "$OUT/ghmcp.toml" <<'TOML'
default_account = "bench"
[[accounts]]
name = "bench"
kind = "classic"
token_env = "GITHUB_PERSONAL_ACCESS_TOKEN"
TOML
GO_COMMIT="${GO_COMMIT:-$(git -C "$GO_SRC" rev-parse HEAD)}" RS_COMMIT="${RS_COMMIT:-$(git -C "$ROOT" rev-parse HEAD)}" GO_VERSION="$(go version)" RUSTC_VERSION="$(rustc --version)" GO_BIN="$GO_BIN" RS_BIN="$RS_BIN" RS_CONFIG="$OUT/ghmcp.toml" \
  node "$ROOT/bench/bench.mjs" "$ROOT/bench/results.json"
node "$ROOT/bench/chart.mjs" "$ROOT/bench/results.json" "$ROOT/bench/chart.svg"
